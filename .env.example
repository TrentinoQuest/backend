# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://admin:admin@localhost:27017/trentino-quest?authSource=admin
DB_RETRY_INTERVAL_MS=5000

# JWT
JWT_SECRET=406aa2c38f27127dd1e16955c3e9e1f0cefea32be597946c1bda6e20b192af40 # Da cambiare in produzione
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Geo anti-cheat
GEO_MAX_ACCURACY_METERS=100
GEO_MAX_FIX_AGE_SECONDS=60

# Firebase (push notifications)
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# OAuth Google
GOOGLE_CLIENT_ID=           # Client ID da Google Cloud Console
# In sviluppo locale, imposta SKIP_OAUTH_VERIFICATION=true per bypassare la verifica del token.
# NON usare in produzione.
SKIP_OAUTH_VERIFICATION=false

# OAuth Apple (non ancora implementato — richiede account sviluppatore Apple)
APPLE_CLIENT_ID=            # Service ID da Apple Developer
APPLE_TEAM_ID=              # Team ID Apple
APPLE_KEY_ID=               # Key ID del certificato Apple
APPLE_PRIVATE_KEY=          # Contenuto del file .p8 (o path al file)
