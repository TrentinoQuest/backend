# Server
NODE_ENV=development
PORT=3000

#MongoDB
MONGODB_URI=mongodb://admin:admin@localhost:27017/trentino-quest?authSource=admin
DB_RETRY_INTERVAL_MS=5000

# JWT
JWT_SECRET=406aa2c38f27127dd1e16955c3e9e1f0cefea32be597946c1bda6e20b192af40 # Da cambiare con una chiave segreta più sicura in produzione
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OAuth Google (solo Google è implementato; Apple richiede account sviluppatore Apple)
GOOGLE_CLIENT_ID=           # Client ID da Google Cloud Console
# In sviluppo locale, imposta SKIP_OAUTH_VERIFICATION=true per bypassare la verifica del token Google.
# NON usare in produzione.
SKIP_OAUTH_VERIFICATION=false
